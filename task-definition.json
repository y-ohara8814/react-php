{
    "family": "my-app-task",
    "networkMode": "awsvpc",
    "requiresCompatibilities": ["FARGATE"],
    "cpu": "256",
    "memory": "512",
    "executionRoleArn": "arn:aws:iam::488556175634:role/ecsTaskExecutionRole",
    "enableExecuteCommand": true,
    "containerDefinitions": [
      {
        "name": "backend",
        "image": "488556175634.dkr.ecr.ap-northeast-1.amazonaws.com/my-app-backend:latest",
        "memory": 256,
        "cpu": 128,
        "essential": true,
        "portMappings": [
          {
            "containerPort": 80,
            "hostPort": 80
          }
        ]
      },
      {
        "name": "frontend",
        "image": "488556175634.dkr.ecr.ap-northeast-1.amazonaws.com/my-app-frontend:latest",
        "memory": 256,
        "cpu": 128,
        "essential": true,
        "portMappings": [
          {
            "containerPort": 5173,
            "hostPort": 5173
          }
        ]
      }
    ]
  }
