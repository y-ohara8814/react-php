  {
    "family": "my-app-task",
    "taskRoleArn": "arn:aws:iam::488556175634:role/ecsTaskExecutionRole",
    "executionRoleArn": "arn:aws:iam::488556175634:role/ecsTaskExecutionRole",
    "networkMode": "awsvpc",
    "requiresCompatibilities": ["FARGATE"],
    "cpu": "256",
    "memory": "512",
    "containerDefinitions": [
      {
        "name": "my-app-backend",
        "image": "<IMAGE_URI>",
        "cpu": 128,
        "memory": 256,
        "portMappings": [
          {
            "containerPort": 80,
            "hostPort": 80,
            "protocol": "tcp"
          }
        ],
        "essential": true
      }
    ]
  }
